{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EarthMesh Studio",
  "version": "3.0.0-alpha2",
  "identifier": "edu.sysu.earthmesh.studio",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EarthMesh Studio",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
