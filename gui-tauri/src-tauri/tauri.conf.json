{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EarthMesh Studio",
  "version": "3.0.0-alpha4",
  "identifier": "edu.sysu.earthmesh.studio",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EarthMesh Studio",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://server.arcgisonline.com",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://server.arcgisonline.com",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon@2x.png"
    ]
  }
}
